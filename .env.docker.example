# Configuración de la aplicación en Docker.
# Copiar a .env.docker (no se versiona) y completar los valores.
# Laragon NO usa este archivo: sigue usando .env.

APP_NAME="Gestion ZFP"
# production = despliegue (cachés activas, sin debug). docker-compose.dev.yml lo cambia a local.
APP_ENV=production
# Use la misma APP_KEY del entorno anterior (Laragon) o genere una nueva (ver DESPLIEGUE.md)
APP_KEY=
APP_DEBUG=false
# URL con la que los usuarios abren la app (servidor: http://10.0.10.5:8081)
APP_URL=http://10.0.10.5:8081

LOG_CHANNEL=stack
LOG_LEVEL=warning

# --- Base de datos -------------------------------------------------
DB_CONNECTION=pgsql
# Servidor con Portainer (docker-compose.server.yml): contenedor "postgres" de la red postgres-stack_zfp-net
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=infraestructura
DB_USERNAME=
DB_PASSWORD=
# Otras opciones:
#   Desde un equipo de la red (fuera del servidor):  DB_HOST=10.0.10.5   DB_PORT=5432
#   Base propia en Docker (perfil db-local):         DB_HOST=db          DB_PORT=5432

# Usadas solo por el contenedor "db" (perfil db-local) al crearse por primera vez
POSTGRES_DB=infraestructura
POSTGRES_USER=
POSTGRES_PASSWORD=

# --- Sesiones, caché y colas (en archivos dentro de data/storage) ---
SESSION_DRIVER=file
SESSION_LIFETIME=120
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
FILESYSTEM_DISK=public
BROADCAST_DRIVER=log

# --- Login con Google ------------------------------------------------
# Registrar esta misma URL en la consola de Google. Valores completos: Docker no resuelve ${...} entre claves.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://10.0.10.5:8081/auth/google/callback

# --- Correo ----------------------------------------------------------
MAIL_MAILER=log
MAIL_FROM_ADDRESS="no-reply@zonafrancapalmaseca.com.co"
MAIL_FROM_NAME="Gestion ZFP"
